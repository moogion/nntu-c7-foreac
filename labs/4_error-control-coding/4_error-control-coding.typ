#figure(
  ```python
  def transmit_bsc(bits: str, p: float, rng: np.random.Generator) -> str:
      if p <= 0: return bits
      flips = rng.random(len(bits)) < p
      return "".join("1" if (b == "1") ^ f else "0" for b, f in zip(bits, flips))

  def run_parity_arq(data: bytes, p: float, seed: int = 42) -> TransmissionStats:
      rng = np.random.default_rng(seed)
      zeros, ones, retries, residual = 0, 0, 0, 0
      for byte in data:
          b_str = f"{byte:08b}"
          frame = b_str + str(b_str.count("1") % 2)
          while True:
              zeros += frame.count("0")
              ones += frame.count("1")
              rx = transmit_bsc(frame, p, rng)
              if (rx[:8].count("1") % 2) == int(rx[8]):
                  if rx[:8] != b_str:
                      residual += 1
                  break
              retries += 1
      return TransmissionStats(len(data), zeros + ones, zeros, ones, retries, 0, residual)
  ```,
  caption: [Моделирование передачи с битом четности и повторным запросом],
) <lst:parity-arq>

При отсутствии помех ($p = 0$) каждый исходный байт преобразуется в 9-битный кадр, что формирует минимальную базовую избыточность $12,5\%$. При наличии шума в канале (например, $p = 0,05$) среднее число попыток передачи одного байта возрастает примерно до $1,44$, при этом часть кадров с четным числом искажений ($2, 4, 6, 8$ бит) проходит проверку четности и формирует необнаруженные (остаточные) ошибки на приемной стороне.

= Код Хэмминга (7, 4) с восстановлением ошибок

Во втором задании содержимое файла `war_peace.txt` кодируется линейным блочным кодом Хэмминга $(7, 4)$. Каждый 8-битный байт разбивается на два независимых 4-битных блока (старшую и младшую тетрады), к каждому из которых добавляются три проверочных бита $c_1, c_2, c_4$ на позициях $1, 2, 4$ в соответствии с выражениями @eq:hamming-encode[]. В результате каждый исходный байт передается двумя 7-битными кодовыми словами суммарной длиной 14 бит (фиксированная избыточность $75\%$).

На приемной стороне для каждого принятого 7-битного блока вычисляются проверочные синдромы $s_1, s_2, s_4$ по формулам @eq:hamming-syndrome[] и номер поврежденного разряда $"pos"$ по формуле @eq:hamming-pos[]. При $"pos" != 0$ соответствующий бит инвертируется, после чего из позиций $3, 5, 6, 7$ извлекаются восстановленные информационные разряды и выполняется сборка двух тетрад обратно в байт. Повторные запросы к передатчику в данной схеме не применяются.

Реализация процедур кодирования и декодирования кода Хэмминга $(7, 4)$ приведена в @lst:hamming-codec[листинге], а общий алгоритм передачи и коррекции ошибок — в @lst:hamming-run[листинге].

#figure(
  ```python
  def encode_hamming_74(d: str) -> str:
      d1, d2, d3, d4 = (int(x) for x in d)
      c1, c2, c4 = d1 ^ d2 ^ d4, d1 ^ d3 ^ d4, d2 ^ d3 ^ d4
      return f"{c1}{c2}{d1}{c4}{d2}{d3}{d4}"

  def decode_hamming_74(rx: str) -> tuple[str, bool]:
      b = [int(x) for x in rx]
      s1 = b[0] ^ b[2] ^ b[4] ^ b[6]
      s2 = b[1] ^ b[2] ^ b[5] ^ b[6]
      s4 = b[3] ^ b[4] ^ b[5] ^ b[6]
      pos = s1 + 2 * s2 + 4 * s4
      if pos: b[pos - 1] ^= 1
      return f"{b[2]}{b[4]}{b[5]}{b[6]}", (pos != 0)
  ```,
  caption: [Кодер и декодер кода Хэмминга $(7, 4)$],
) <lst:hamming-codec>

#figure(
  ```python
  def run_hamming_74(data: bytes, p: float, seed: int = 42) -> TransmissionStats:
      rng = np.random.default_rng(seed)
      zeros, ones, corrected, residual = 0, 0, 0, 0
      for byte in data:
          b_str = f"{byte:08b}"
          rx_nibbles = []
          for nibble in (b_str[:4], b_str[4:]):
              tx = encode_hamming_74(nibble)
              zeros += tx.count("0"); ones += tx.count("1")
              rx = transmit_bsc(tx, p, rng)
              dec, was_corr = decode_hamming_74(rx)
              corrected += int(was_corr)
              rx_nibbles.append(dec)
          if "".join(rx_nibbles) != b_str:
              residual += 1
      return TransmissionStats(len(data), zeros + ones, zeros, ones, 0, corrected, residual)
  ```,
  caption: [Передача и коррекция ошибок кодом Хэмминга $(7, 4)$],
) <lst:hamming-run>

Ключевой особенностью алгоритма в @lst:hamming-run[листинге] является детерминированный объем передаваемых по каналу данных: независимо от уровня шума в канале связи для файла объемом $N_"байт"$ в линию всегда передается ровно $14 dot N_"байт"$ бит (или $1,75 dot N_"байт"$ эквивалентных 8-битных байт). При этом все одиночные битовые искажения в пределах каждой 7-битной кодовой комбинации гарантированно исправляются декодером в реальном времени.

= Вычислительный эксперимент и сравнительный анализ

== Методика эксперимента и векторизация моделирования

Поскольку текстовый файл `war_peace.txt` имеет значительный объем (порядка нескольких мегабайт), многократный посимвольный прогон циклами Python по сетке вероятностей ошибки $p in [0; 0,45]$ требует существенных вычислительных затрат. В соответствии с современными практиками научных расчетов на Python для проведения серийного эксперимента в задании 3 разработана математически эквивалентная векторизованная реализация на базе `NumPy` (`np.unpackbits`, матричные операции `XOR`), функции которой приведены в @lst:fast-sim-arq[листинге] и @lst:fast-sim-ham[листинге], а вычисление кривых и сохранение векторных иллюстраций — в @lst:experiment[листинге] и @lst:experiment-plots[листинге]. Для корректного сопоставления разноразрядных кодовых слов объем переданных данных пересчитывается в эквивалентное количество 8-битных байт: $N_"пер. байт" = N_"пер. бит" \/ 8$.

#figure(
  ```python
  def simulate_parity_arq_fast(bits: np.ndarray, p: float, rng: np.random.Generator):
      n_bytes = bits.shape[0]
      pending = np.arange(n_bytes)
      total_bits, undetected = 0, 0
      while pending.size > 0:
          total_bits += pending.size * 9
          if p <= 0.0: break
          err_counts = np.sum(rng.random((pending.size, 9)) < p, axis=1)
          accepted = (err_counts & 1) == 0
          undetected += int(np.count_nonzero(err_counts[accepted] > 0))
          pending = pending[~accepted]
      return total_bits / 8.0, undetected / n_bytes
  ```,
  caption: [Векторизованное моделирование канала с битом четности и повтором],
) <lst:fast-sim-arq>

#figure(
  ```python
  def simulate_hamming_74_fast(bits: np.ndarray, p: float, rng: np.random.Generator):
      n_bytes = bits.shape[0]
      d = bits.reshape(-1, 4)
      c1, c2, c4 = d[:,0]^d[:,1]^d[:,3], d[:,0]^d[:,2]^d[:,3], d[:,1]^d[:,2]^d[:,3]
      cw = np.column_stack([c1, c2, d[:,0], c4, d[:,1], d[:,2], d[:,3]])
      if p <= 0.0: return cw.size / 8.0, 0.0
      rx = cw ^ (rng.random(cw.shape) < p).astype(np.uint8)
      s1 = rx[:,0] ^ rx[:,2] ^ rx[:,4] ^ rx[:,6]
      s2 = rx[:,1] ^ rx[:,2] ^ rx[:,5] ^ rx[:,6]
      s4 = rx[:,3] ^ rx[:,4] ^ rx[:,5] ^ rx[:,6]
      pos = s1 + 2 * s2 + 4 * s4
      corr = pos > 0
      rx[np.nonzero(corr)[0], pos[corr] - 1] ^= 1
      dec = rx[:, [2, 4, 5, 6]].reshape(n_bytes, 8)
      return cw.size / 8.0, int(np.count_nonzero(np.any(dec != bits, axis=1))) / n_bytes
  ```,
  caption: [Векторизованное моделирование канала с кодом Хэмминга $(7, 4)$],
) <lst:fast-sim-ham>

