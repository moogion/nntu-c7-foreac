  from dataclasses import dataclass
  from pathlib import Path
  import numpy as np
  import requests

  DATA_PATH = Path("assets/data/war_peace.txt")
  DATA_URL = "https://raw.githubusercontent.com/NNTU-CS/RECF-2026/main/Data/war_peace.txt"

  @dataclass(frozen=True)
  class TransmissionStats:
      source_bytes: int
      total_bits: int
      zeros_sent: int
      ones_sent: int
      retransmissions: int
      corrected_errors: int
      residual_byte_errors: int

  def load_data(path: Path = DATA_PATH) -> bytes:
      if not path.exists():
          path.parent.mkdir(parents=True, exist_ok=True)
          r = requests.get(DATA_URL, timeout=30)
          r.raise_for_status()
          path.write_bytes(r.content)
      return path.read_bytes()
  ```,
